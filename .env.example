# Invite link of the WhatsApp channel to post to (https://whatsapp.com/channel/...)
# or its @newsletter id. The linked WhatsApp account must own or admin it.
WHATSAPP_CHANNEL=

# Password for the poster page. SET THIS in production or anyone with the URL can post.
POSTER_PASSWORD=

# Appended to every post (leave empty for none). \n = new line.
POST_FOOTER=📲 Follow the channel for more NBA updates

# Time zone for the queue's active hours.
TIMEZONE=America/New_York

# Where the WhatsApp login and the queue are stored. On Railway this
# defaults to /data — mount a volume there so they survive deploys.
DATA_DIR=

# 1 = log posts instead of sending (for testing the formatting).
DRY_RUN=
