# Same WhatsApp bot on Railway as the deal alerts: POST endpoint + bearer token.
# Unset = dry-run (posts are logged, nothing is sent).
WHATSAPP_BOT_URL=
WHATSAPP_BOT_TOKEN=

# Password for the poster page. SET THIS in production or anyone with the URL can post.
POSTER_PASSWORD=

# Appended to every post (leave empty for none). Use \n for line breaks in Railway.
POST_FOOTER=📲 Follow the channel for more NBA updates

# Public base URL the bot uses to fetch uploaded images.
# On Railway this is auto-detected from RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=
